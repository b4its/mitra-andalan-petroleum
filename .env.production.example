# ── Production (docker-compose.prod.yml) ─────────────────────
# Salin file ini menjadi .env.production lalu isi nilai berikut.

# Token autentikasi ngrok — ambil dari https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Domain ngrok. ISIAN OPSIONAL:
#   - Isi untuk memakai domain tetap (harus sudah direserve di akun), mis.
#     mitra-andalan.ngrok-free.app atau domain custom.
#   - Kosongkan untuk memakai URL acak otomatis (contoh: abc123.ngrok-free.dev).
NGROK_DOMAIN=

# URL publik aplikasi (dipakai frontend untuk metadata/OG)
PUBLIC_SITE_URL=http://localhost:8093

# Port HTTP publik lokal (nginx).
# Sengaja beda dari stack dev (frontend :8092) supaya kedua stack bisa
# berjalan paralel tanpa tabrakan port.
HTTP_PORT=8093

# ── Database ─────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=mandalan
MYSQL_PASSWORD=mandalan
MYSQL_DATABASE=mandalan
