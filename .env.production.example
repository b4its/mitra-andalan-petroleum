# ── Production (docker-compose.prod.yml) ─────────────────────
# Salin file ini menjadi .env.production lalu isi nilai berikut.

# Token autentikasi ngrok — ambil dari https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Domain ngrok. ISIAN OPSIONAL:
#   - Isi untuk memakai domain tetap (harus sudah direserve di akun), mis.
#     mitra-andalan.ngrok-free.app atau domain custom.
#   - Kosongkan untuk memakai URL gratis otomatis (contoh: abc123.ngrok-free.dev).
#
# ⚠️  CATATAN (ERR_NGROK_334):
#   Pada paket gratis, satu authtoken hanya boleh punya SATU endpoint online.
#   Jika sebelumnya sudah ada tunnel ngrok berjalan (di perangkat lain / container
#   / dashboard ngrok), tunnel baru akan gagal dengan ERR_NGROK_334:
#   "The endpoint 'https://xxx.ngrok-free.dev' is already online."
#   Solusi:
#     1. Hentikan sesi ngrok lain yang memakai authtoken yang sama, ATAU
#     2. matikan endpoint 'Online' di dashboard ngrok, ATAU
#     3. isi NGROK_DOMAIN dengan domain lain yang sudah direserve.
NGROK_DOMAIN=

# URL publik aplikasi (dipakai frontend untuk metadata/OG)
PUBLIC_SITE_URL=http://localhost:8093

# Port HTTP publik lokal (nginx).
# Sengaja beda dari stack dev (frontend :8092) supaya kedua stack bisa
# berjalan paralel tanpa tabrakan port.
HTTP_PORT=8093

# ── Database ─────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=mandalan
MYSQL_PASSWORD=mandalan
MYSQL_DATABASE=mandalan
